ize: 20px\u003B\u005Cn  }\u005Cn\u005Cn  .scene\u002Dresult p {\u005Cn    font\u002Dsize: 14px\u003B\u005Cn  }\u005Cn\u003C/style\u003E\u005Cn    \u005Cn\u003Cdiv class\u003D\u005C\u0022snippet\u005C\u0022 id\u003D\u005C\u0022snippet\u005C\u0022\u003E\u005Cn  \u003Csection id\u003D\u005C\u0022scene1\u005C\u0022 class\u003D\u005C\u0022scene\u005C\u0022\u003E\u005Cn    \u003Cdiv class\u003D\u005C\u0022scene\u002Dcontent\u005C\u0022\u003E\u005Cn    \u005Cn      \u003Cimg alt\u003D\u005C\u0022snippet icon\u005C\u0022 height\u003D\u005C\u002242\u005C\u0022 width\u003D\u005C\u002242\u005C\u0022 src\u003D\u005C\u0022data:image/png\u003Bbase64,\u003D\u005C\u0022 /\u003E\u005Cn    \u005Cn  \u005Cn      \u003Csection\u003E\u005Cn      \u005Cn        \u003Ch1\u003EBrowse for something secret. \u003C/h1\u003E\u005Cn      \u005Cn        \u003Cp\u003ETry Firefox Focus, the lightweight mobile browser that lets you explore the web without a trace.\u003C/p\u003E\u005Cn      \u003C/section\u003E\u005Cn  \u005Cn      \u003Cbutton type\u003D\u005C\u0022button\u005C\u0022 class\u003D\u005C\u0022button\u002Dlink\u005C\u0022 id\u003D\u005C\u0022learn\u002Dmore\u005C\u0022\u003EInstall now\u003C/button\u003E\u005Cn  \u005Cn    \u005Cn      \u003Cbutton type\u003D\u005C\u0022button\u005C\u0022 class\u003D\u005C\u0022block\u002Dsnippet\u002Dbutton\u005C\u0022 title\u003D\u005C\u0022Remove this\u005C\u0022\u003E\u003C/button\u003E\u005Cn    \u005Cn    \u003C/div\u003E\u003C!\u002D\u002D/.scene\u002Dcontent\u002D\u002D\u003E\u005Cn  \u003C/section\u003E\u005Cn\u005Cn  \u003Csection id\u003D\u005C\u0022scene2\u005C\u0022 class\u003D\u005C\u0022scene hidden\u005C\u0022\u003E\u005Cn    \u003Cdiv class\u003D\u005C\u0022scene\u002Dcontent\u005C\u0022\u003E\u005Cn      \u003Cdiv id\u003D\u005C\u0022scene2\u002Dintro\u005C\u0022\u003E\u005Cn      \u005Cn          \u005Cn        \u003Cp\u003ETry Firefox Focus, the mobile browser that lets you explore the web without a trace.\u003C/p\u003E\u005Cn      