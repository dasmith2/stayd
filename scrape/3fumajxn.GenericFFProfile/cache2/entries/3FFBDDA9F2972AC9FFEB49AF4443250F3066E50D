etch request is successful, show the success message\u005Cn      function subscribeOk() {\u005Cn        const metric \u003D (input_type \u003D\u003D\u003D \u0027email\u0027) ? \u0027activation\u002Demail\u002Dsuccess\u0027 : \u0027activation\u002DSMS\u002Dsuccess\u0027\u003B\u005Cn        \u005Cn        sendMetric(metric)\u003B\u005Cn\u005Cn        scene2.classList.add(\u0027hidden\u0027)\u003B\u005Cn        sceneOk.classList.remove(\u0027hidden\u0027)\u003B\u005Cn      }\u005Cn\u005Cn      // both SMS and email subscriptions respond with the same JSON format\u005Cn      function performFetch(fetchRequest) {\u005Cn        fetch(fetchRequest).then(response \u003D\u003E {\u005Cn          return response.json()\u003B\u005Cn        }).then(json \u003D\u003E {\u005Cn          if (json.status \u003D\u003D\u003D \u0027ok\u0027) {\u005Cn            subscribeOk()\u003B\u005Cn          } else {\u005Cn            subscribeError()\u003B\u005Cn          }\u005Cn        }).catch(err \u003D\u003E {\u005Cn          subscribeError()\u003B\u005Cn        })\u003B\u005Cn      }\u005Cn\u005Cn      function sendSMSToBasket() {\u005Cn        const formData \u003D new FormData()\u003B\u005Cn\u005Cn        sendMetric(\u0027conversion\u002Dmobile\u002Dactivation\u002Dsms\u0027)\u003B\u005Cn\u005Cn        formData.append(\u0027mobile_number\u0027, input.value)\u003B\u005Cn        formData.append(\u0027msg_name\u0027, \u0027\u0027)\u003B\u005Cn        formData.append(\u0027lang\u0027, locale)\u003B\u005Cn        formData.append(\u0027country\u0027, country)\u003B\u005Cn        \u005Cn        const fetchConfig \u003D {\u005Cn          body: formData,\u005Cn          method: \u0027post\u0027\u005Cn        }\u003B\u005Cn\u005Cn        const fetchRequest \u003D new Request(\u0027https://basket.mozilla.org/news/subscribe_sms/\u0027, fetchConfig)\u003B\u005Cn\u005Cn        performFetch(fetchRequest)\u003B\u005Cn      }\u005Cn\u005Cn      function sendEmailToBasket() {\u005Cn        const formData \u