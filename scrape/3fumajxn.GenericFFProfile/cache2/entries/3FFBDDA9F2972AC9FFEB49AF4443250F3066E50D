type\u003D\u005C\u0022button\u005C\u0022 class\u003D\u005C\u0022block\u002Dsnippet\u002Dbutton\u005C\u0022 title\u003D\u005C\u0022Remove this\u005C\u0022\u003E\u003C/button\u003E\u005Cn    \u005Cn    \u003C/div\u003E\u005Cn  \u003C/section\u003E\u005Cn\u003C/div\u003E\u005Cn\u005Cn\u003Cscript type\u003D\u005C\u0022text/javascript\u005C\u0022\u003E\u005Cn  //\u003C![CDATA[\u005Cn  (function() {\u005Cn    const snippet \u003D document.getElementById(\u0027snippet\u0027)\u003B\u005Cn  \u005Cn    snippet.addEventListener(\u0027show_snippet\u0027, function () {\u005Cn      const country \u003D \u0027us\u0027\u003B\u005Cn      const input \u003D document.getElementById(\u0027phone\u002Dor\u002Demail\u0027)\u003B\u005Cn      const learnMoreButton \u003D document.getElementById(\u0027learn\u002Dmore\u0027)\u003B\u005Cn      const locale \u003D \u0027en\u002DUS\u0027\u003B\u005Cn      const scene1 \u003D document.getElementById(\u0027scene1\u0027)\u003B\u005Cn      const scene2 \u003D document.getElementById(\u0027scene2\u0027)\u003B\u005Cn      const scene2Submit \u003D document.getElementById(\u0027scene2\u002Dsubmit\u0027)\u003B\u005Cn      const sceneError \u003D document.getElementById(\u0027sceneError\u0027)\u003B\u005Cn      const sceneOk \u003D document.getElementById(\u0027sceneOk\u0027)\u003B\u005Cn      const sendToDeviceForm \u003D document.getElementById(\u0027send\u002Dto\u002Ddevice\u002Dform\u0027)\u003B\u005Cn\u005Cn      let input_type\u003B // set each time input field is modified/per keystroke\u005Cn\u005Cn      // check if it is a valid email or phone number or neither\u005Cn      function checkInput(val, locale) {\u005Cn        // http://emailregex.com/\u005Cn        const email_re \u003D /^(([^\u003C\u003E()[\u005C\u005C]\u005C\u005C\u005C\u005C.,\u003B:\u005C\u005Cs@\u005C\u0022]+(\u005C\u005C.[^\u003C\u003E()[\u005C\u005C]\u005C\u005C\u005C\u005C.,\u003B:\u005C\u005Cs@\u005C\u0022]+)*)|(\u005C\u0022.+\u005C\u0022))@((\u005C\u005C[[0\u002D9]{1,3}\u00