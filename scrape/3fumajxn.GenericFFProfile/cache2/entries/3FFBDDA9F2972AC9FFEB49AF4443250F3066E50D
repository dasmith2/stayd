dy: formData,\u005Cn          method: \u0027post\u0027\u005Cn        }\u003B\u005Cn\u005Cn        const fetchRequest \u003D new Request(\u0027https://basket.mozilla.org/news/subscribe_sms/\u0027, fetchConfig)\u003B\u005Cn\u005Cn        performFetch(fetchRequest)\u003B\u005Cn      }\u005Cn\u005Cn      function sendEmailToBasket() {\u005Cn        const formData \u003D new FormData()\u003B\u005Cn\u005Cn        sendMetric(\u0027conversion\u002Dmobile\u002Dactivation\u002Demail\u0027)\u003B\u005Cn\u005Cn        formData.append(\u0027email\u0027, input.value)\u003B\u005Cn        formData.append(\u0027lang\u0027, locale)\u003B\u005Cn        formData.append(\u0027newsletters\u0027, \u0027download\u002Dfirefox\u002Dmobile\u0027)\u003B\u005Cn        formData.append(\u0027source_url\u0027, encodeURIComponent(\u0027https://snippets.mozilla.com/show/7991\u0027))\u003B\u005Cn        \u005Cn        const fetchConfig \u003D {\u005Cn          body: formData,\u005Cn          method: \u0027post\u0027\u005Cn        }\u003B\u005Cn\u005Cn        const fetchRequest \u003D new Request(\u0027https://basket.mozilla.org/news/subscribe/\u0027, fetchConfig)\u003B\u005Cn\u005Cn        performFetch(fetchRequest)\u003B\u005Cn      }\u005Cn\u005Cn      // displays scene 2/the form\u005Cn      learnMoreButton.addEventListener(\u0027click\u0027, () \u003D\u003E {\u005Cn        sendMetric(\u0027button\u002Dclick\u0027)\u003B\u005Cn\u005Cn        scene1.classList.add(\u0027hidden\u0027)\u003B\u005Cn        scene2.classList.remove(\u0027hidden\u0027)\u003B\u005Cn\u005Cn        sendToDeviceForm.addEventListener(\u0027submit\u0027, e \u003D\u003E {\u005Cn          e.preventDefault()\u003B\u005Cn\u005Cn          // disable form submit button\u005Cn          scene2Submit.disabled \u003D true\u003B\u005Cn\u005Cn          if (input_type \u003D\u003D\u003D \u0027email\u0027) {\u005Cn            sendEmailToBasket()\u003B\u005Cn          } else if (input_type \u003D\u003D\u003D \u0027phone\u0027) {\u005Cn            sendSMSToBasket()\u003B\u005Cn          }\u005Cn        })\u003B\u005Cn      })\u003B\u005Cn\u005Cn      // check input while typing\u005Cn      input.addEventListener(\u0027input\u0027, () \u003D\u003E {\u005Cn        input_type \u003D checkInput(input.value, locale)\u003B\u005Cn\u005Cn        // disable the submit button while input_type is false\u005Cn        scene2Submit.disabled \u003D (input_type \u003D\u003D\u003D false)\u003B\u005Cn      })\u003B\u005Cn\u005Cn      // initializes input_type by firing the input handler above on page load\u005Cn      const evt \u003D document.createEvent(\u0027HTMLEvents\u0027)\u003B\u005Cn      evt.initEvent(\u0027input\u0027, false, true)\u003B\u005Cn      input.dispatchEvent(evt)\u003B\u005Cn    })\u003B\u005Cn  })()\u003B\u005Cn  //]]\u003E\u005Cn\u003C/script\u003E\u003C/div\u003E\u0022, \u0022exclude_from_search_engines\u0022: [], \u0022name\u0022: \u0022MOCO_global_2018_f100_week2_mobile_fullfeatured_emailonly_activity_stream_EN_REL\u0022, \u0022campaign\u0022: \u0022f100 mobile email only\u0022, \u0022countries\u0022: [], \u0022client_options\u0022: {\u0022has_testpilot\u0022: \u0022any\u0022, \u0022is_default_browser\u0022: \u0022any\u0022, \u0022screen_resolutions\u0022: \u00220\u002D1024\u003B1024\u002D1920\u003B1920\u002D50000\u0022, \u0022version_lower_bound\u0022: \u0022any\u0022, \u0022profileage_upper_bound\u0022: 3, \u0022has_fxaccount\u0022: \u0022any\u0022, \u0022profileage_lower_bound\u0022: 1, \u0022version_upper_bound\u0022: \u0022any\u0022}, \u0022id\u0022: 7991, \u0022weight\u0022: 100}, {\u0022code\u0022: \u0022\u003Cdiv data\u002Dsnippet\u002Did\u003D\u005C\u00227992\u005C\u0022 data\u002Dweight\u003D\u005C\u0022100\u005C\u0022 data\u002Dcampaign\u003D\u005C\u0022f100 focus email only\u005C\u0022 class\u003D\u005C\u0022snippet\u002Dmetadata\u005C\u0022\u003E\u005Cn\u003Cstyle\u003E\u005Cn  /* helper classes */\u005Cn  .hidden {\u005Cn    display: none !important\u003B\u005Cn  }\u005Cn\u005Cn  /* 