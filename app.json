{
  "name": "Stayd",
  "description": "A Django app that basically runs Stayd",
  "image": "heroku/python",
  "repository": "https://github.com/dasmith2/stayd.git",
  "keywords": ["python", "django"],
  "addons": ["heroku-postgresql"],
  "env": {
    "SECRET_TOKEN": "A secret key for verifying the integrity of signed cookies.",
    "generator": "secret"
  },
  "environments": {
    "test": {
      "env": {
        "IN_HEROKU_CI": "yep."
      },
      "scripts": {
        "test-setup": "python manage.py migrate",
        "test": "./test.sh"
      }
    }
  }
}
