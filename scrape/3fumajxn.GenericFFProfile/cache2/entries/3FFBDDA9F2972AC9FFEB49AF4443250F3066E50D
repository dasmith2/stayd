ng: 6px\u003B\u005Cn  }\u005Cn\u005Cn  @media (min\u002Dwidth: 544px) {\u005Cn    #phone\u002Dor\u002Demail {\u005Cn      margin\u002Dbottom: 0\u003B\u005Cn      width: 40%\u003B\u005Cn    }\u005Cn  }\u005Cn\u005Cn  @media (min\u002Dwidth: 766px) {\u005Cn    #phone\u002Dor\u002Demail {\u005Cn      width: 50%\u003B\u005Cn    }\u005Cn  }\u005Cn\u005Cn  form {\u005Cn    margin\u002Dbottom: 20px\u003B\u005Cn  }\u005Cn\u005Cn  form button {\u005Cn    background: #0060df\u003B\u005Cn    border: 0\u003B\u005Cn    border\u002Dradius: 2px\u003B\u005Cn    color: #fff\u003B\u005Cn    cursor: pointer\u003B\u005Cn    font\u002Dsize: 14px\u003B\u005Cn    padding: 8px 20px\u003B\u005Cn  }\u005Cn\u005Cn  form button:disabled {\u005Cn    cursor: default\u003B\u005Cn    opacity: 0.5\u003B\u005Cn  }\u005Cn\u005Cn\u005Cn  #scene2\u002Dfooter {\u005Cn    background: rgba(12, 12, 13, 5%)\u003B\u005Cn    padding: 10px 0\u003B\u005Cn    text\u002Dalign: right\u003B\u005Cn  }\u005Cn\u005Cn  #scene2\u002Dfooter .scene\u002Dcontent {\u005Cn    padding: 0\u003B\u005Cn  }\u005Cn\u005Cn  #scene2\u002Dfooter .block\u002Dsnippet\u002Dbutton {\u005Cn    background: #f9f9fa\u003B\u005Cn    border: 1px solid #d7d7db\u003B\u005Cn    color: #3b3b3b\u003B\u005Cn    height: auto\u003B\u005Cn    margin: 0\u003B\u005Cn    offset\u002Dinline\u002Dend: auto\u003B\u005Cn    opacity: 1\u003B\u005Cn    position: relative\u003B\u005Cn    top: 0\u003B\u005Cn    width: auto\u003B\u005Cn  }\u005Cn\u005Cn  .snippet #scene2\u002Dfooter .block\u002Dsnippet\u002Dbutton,\u005Cn  #snippets\u002Dcontainer:hover .snippet #scene2\u002Dfooter .block\u002Dsnippet\u002Dbutton {\u005Cn      display: inline\u002Dblock\u003B\u005Cn  }\u005Cn\u005Cn\u005Cn  .scene\u002Dresult {\u005Cn    padding\u002Dbottom: 20px\u003B\u005Cn    text\u002Dalign: center\u003B\u005Cn  }\u005Cn\u005Cn  .scene\u002Dresult h1 {\u005Cn    font\u002Dsize: 20px\u003B\u005Cn  }\u005Cn\u005Cn  .scene\u002Dresult p {\u005Cn    font\u002Dsize: 14px\u003B\u005Cn  }\u005Cn\u003C/style\u003E\u005Cn    \u005Cn\u003Cdiv class\u003D\u005C\u0022snippet\u005C\u0022 id\u003D\u005C\u0022snippet\u005C\u0022\u003E\u005Cn  \u003Csection id\u003D\u005C\u0022scene1\u005C\u0022 class\u003D\u005C\u0022scene\u005C\u0022\u003E\u005Cn    \u003Cdiv class\u003D\u005C\u0022scene\u002Dcontent\u005C\u0022\u003E\u005Cn    \u005Cn      \u003Cimg alt\u003D\u005C\u0022snippet icon\u005C\u0022 height\u003D\u005C\u002242\u005C\u0022 width\u003D\u005C\u002242\u005C\u0022 src\u003D\u005C\u0022data:image/png\u003Bbase64,\u003D\u005C\u0022 /\u003E\u005Cn    \u005Cn  \u005Cn      \u003Csection\u003E\u005Cn      \u005Cn        \u003Cp\u003EGet an extra dose of privacy with Firefox Focus \u005Cu2014 the privacy browser for your mobile device.\u003C/p\u003E\u005Cn      \u003C/section\u003E\u005Cn  \u005Cn      \u003Cbutton type\u003D\u005C\u0022button\u005C\u0022 class\u003D\u005C\u0022button\u002Dlink\u005C\u0022 id\u003D\u005C\u0022learn\u002Dmore\u005C\u0022\u003EInstall now\u003C/button\u003E\u005Cn  \u005Cn    \u005Cn      \u003Cbutton type\u003D\u005C\u0022button\u005C\u0022 class\u003D\u005C\u0022block\u002Dsnippet\u002Dbutton\u005C\u0022 title\u003D\u005C\u0022Remove this\u005C\u0022\u003E\u003C/button\u003E\u005Cn    \u005Cn    \u003C/div\u003E\u003C!\u002D\u002D/.scene\u002Dcontent\u002D\u002D\u003E\u005Cn  \u003C/section\u003E\u005Cn\u005Cn  \u003Csection id\u003D\u005C\u0022scene2\u005C\u0022 class\u003D\u005C\u0022scene hidden\u005C\u0022\u003E\u005Cn    \u003Cdiv class\u003D\u005C\u0022scene\u002Dcontent\u005C\u0022\u003E\u005Cn      \u003Cdiv id\u003D\u005C\u0022scene2\u002Dintro\u005C\u0022\u003E\u005Cn      \u005Cn          \u005Cn        \u003Cp\u003EGet Firefox Focus, the privacy browser for your mobile device.\u003C/p\u003E\u005Cn      \u003C/div\u003E\u005Cn  \u005Cn      \u003Cform action\u003D\u005C\u0022\u005C\u0022 id\u003D\u005C\u0022send\u002Dto\u002Ddevice\u002Dform\u005C\u0022\u003E\u005Cn        \u003Cinput id\u003D\u005C\u0022phone\u002Dor\u002Demail\u005C\u0022 name\u003D\u005C\u0022phone\u002Dor\u002Demail\u005C\u0022 type\u003D\u005C\u0022text\u005C\u0022 required\u003D\u005C\u0022required\u005C\u0022 placeholder\u003D\u005C\u0022Enter your phone number or email\u005C\u0022 /\u003E\u005Cn        \u003Cbutton type\u003D\u005C\u0022submit\u005C\u0022 id\u003D\u005C\u0022scene2\u002Dsubmit\u005C\u0022\u003ESend\u003C/button\u003E\u005Cn      \u003C/form\u003E\u005Cn\u005Cn    \u005Cn      \u003Cp\u003E\u005Cn        SMS service available to U.S. phone numbers only. SMS \u0026amp\u003B data rates may apply. The intended recipient of the email or SMS must have consented. \u003Ca href\u003D\u005C\u0022https://www.mozilla.org/en\u002DUS/privacy/firefox/#snippets\u005C\u0022 class\u003D\u005C\u0022more\u005C\u0022\u003ELearn more\u003C/a\u003E\u005Cn      \u003C/p\u003E\u005Cn    \u005Cn    \u003C/div\u003E\u003C!\u002D\u002D/.scene\u002Dcontent\u002D\u002D\u003E\u005Cn\u005Cn  \u005Cn    \u003Cfooter id\u003D\u005C\u0022scene2\u002Dfooter\u005C\u0022\u003E\u005Cn      \u003Cdiv class\u003D\u005C\u0022scene\u002Dcontent\u005C\u0022\u003E\u005Cn        \u003Cbutton type\u003D\u005C\u0022button\u005C\u0022 class\u003D\u005C\u0022block\u002Dsnippet\u002Dbutton button\u002Dlink\u005C\u0022 data\u002Dmetric\u003D\u005C\u0022snippet\u002Dscene2\u002Dblocked\u005C\u0022\u003EDismiss\u003C/button\u003E\u005Cn      \u003C/div\u003E\u005Cn    \u003C/footer\u003E\u005Cn  \u005Cn  \u003C/section\u003E\u005Cn\u005Cn  \u003Csection id\u003D\u005C\u0022sceneOk\u005C\u0022 class\u003D\u005C\u0022scene scene\u002Dresult hidden\u005C\u0022\u003E\u005Cn    \u003Cdiv class\u003D\u005C\u0022scene\u002Dcontent\u005C\u0022\u003E\u005Cn      \u003Ch1\u003EYour download link was sent.\u003C/h1\u003E\u005Cn\u005Cn      \u003Cp\u003ECheck your device for the email or text message!\u003C/p\u003E\u005Cn\u005Cn    \u005Cn      \u003Cbutton type\u003D\u005C\u0022button\u005C\u0022 class\u003D\u005C\u0022block\u002Dsnippet\u002Dbutton\u005C\u0022 title\u003D\u005C\u0022Remove this\u005C\u0022\u003E\u003C/button\u003E\u005Cn    \u005Cn    \u003C/div\u003E\u005Cn  \u003C/section\u003E\u005Cn\u005Cn  \u003Csection id\u003D\u005C\u0022sceneError\u005C\u0022 class\u003D\u005C\u0022scene scene\u002Dresult hidden\u005C\u0022\u003E\u005Cn    \u003Cdiv class\u003D\u005C\u0022scene\u002Dcontent\u005C\u0022\u003E\u005Cn      \u003Cp\u003EThere was an error processing your request\u003C/p\u003E\u005Cn\u005Cn    \u005Cn      \u003Cbutton type\u003D\u005C\u0022button\u005C\u0022 class\u003D\u005C\u0022block\u002Dsnippet\u002Dbutton\u005C\u0022 title\u003D\u005C\u0022Remove this\u005C\u0022\u003E\u003C/button\u003E\u005Cn    \u005Cn    \u003C/div\u003E\u005Cn  \u003C/section\u003E\u005Cn\u003C/div\u003E\u005Cn\u005Cn\u003Cscript type\u003D\u005C\u0022text/javascript\u005C\u0022\u003E\u005Cn  //\u003C![CDATA[\u005Cn  (function() {\u005Cn    const snippet \u003D document.getElementById(\u0027snippet\u0027)\u003B\u005Cn  \u005Cn    snippet.addEventListener(\u0027show_snippet\u0027, function () {\u005Cn      const country \u003D \u0027us\u0027\u003B\u005Cn      const input \u003D document.getElementById(\u0027phone\u002Dor\u002Demail\u0027)\u003B\u005Cn      const learnMoreButton \u003D document.getElementById(\u0027learn\u002Dmore\u0027)\u003B\u005Cn      const locale \u003D \u0027en\u002DUS\u0027\u003B\u005Cn      const scene1 \u003D document.getElementById(\u0027scene1\u0027)\u003B\u005Cn      const scene2 \u003D document.getElementById(\u0027scene2\u0027)\u003B\u005Cn      const scene2Submit \u003D document.getElementById(\u0027scene2\u002Dsubmit\u0027)\u003B\u005Cn      const sceneError \u003D document.getElementById(\u0027sceneError\u0027)\u003B\u005Cn      const sceneOk \u003D document.getElementById(\u0027sceneOk\u0027)\u003B\u005Cn      const sendToDeviceForm \u003D document.getElementById(\u0027send\u002Dto\u002Ddevice\u002Dform\u0027)\u003B\u005Cn\u005Cn      let input_type\u003B // set each time input field is modified/per keystroke\u005Cn\u005Cn      // check if it is a valid email or phone number or neither\u005Cn      function checkInput(val, locale) {\u005Cn        // http://emailregex.com/\u005Cn        const email_re \u003D /^(([^\u003C\u003E()[\u005C\u005C]\u005C\u005C\u005C\u005C.,\u003B:\u005C\u005Cs@\u005C\u0022]+(\u005C\u005C.[^\u003C\u003E()[\u005C\u005C]\u005C\u005C\u005C\u005C.,\u003B:\u005C\u005Cs@\u005C\u0022]+)*)|(\u005C\u0022.+\u005C\u0022))@((\u005C\u005C[[0\u002D9]{1,3}\u005C\u005C.[0\u002D9]{1,3}\u005C\u005C.[0\u002D9]{1,3}\u005C\u005C.[0\u002D9]{1,3}])|(([a\u002DzA\u002DZ\u005C\u005C\u002D0\u002D9]+\u005C\u005C.)+[a\u002DzA\u002DZ]{2,}))$/\u003B\u005Cn        const check_email \u003D email_re.test(val)\u003B\u005Cn        let check_phone\u003B // depends on locale\u005Cn\u005Cn        switch (locale) {\u005Cn          case \u0027en\u002DUS\u0027:\u005Cn            // allow 10\u002D11 digits in case user wants to enter country code\u005Cn            check_phone \u003D val.length \u003E\u003D 10 \u0026\u0026 val.length \u003C\u003D 11 \u0026\u0026 !isNaN(val)\u003B\u005Cn            break\u003B\u005Cn          case \u0027de\u0027:\u005Cn            // allow between 2 and 12 digits for german phone numbers\u005Cn            check_phone \u003D val.length \u003E\u003D 2 \u0026\u0026 val.length \u003C\u003D 12 \u0026\u0026 !isNaN(val)\u003B\u005Cn            break\u003B\u005Cn          // this case should never be hit, but good to have a fallback just in case\u005Cn          default:\u005Cn            check_phone \u003D !isNaN(val)\u003B\u005Cn            break\u003B\u005Cn        }\u005Cn        \u005Cn        if (check_email) {\u005Cn            return \u0027email\u0027\u003B\u005Cn        } else if (\u0027True\u0027 \u003D\u003D\u003D \u0027True\u0027 \u0026\u0026 check_phone) {\u005Cn            return \u0027phone\u0027\u003B\u005Cn        } else {\u005Cn            return false\u003B\u005Cn        }\u005Cn      }\u005Cn\u005Cn      // if fetch request fails, show the error message\u005Cn      function subscribeError() {\u005Cn        const metric \u003D input_type \u003D\u003D\u003D \u0027email\u0027 ? \u0027activation\u002Demail\u002Derror\u0027 : \u0027activation\u002DSMS\u002Derror\u0027\u003B\u005Cn        \u005Cn        sendMetric(metric)\u003B\u005Cn        \u005Cn        scene2.classList.add(\u0027hidden\u0027)\u003B\u005Cn        sceneError.classList.remove(\u0027hidden\u0027)\u003B\u005Cn      }\u005Cn  \u005Cn      // if fetch request is successful, show the success message\u005Cn      function subscribeOk() {\u005Cn        const metric \u003D (input_type \u003D\u003D\u003D \u0027email\u0027) ? \u0027activation\u002Demail\u002Dsuccess\u0027 : \u0027activation\u002DSMS\u002Dsuccess\u0027\u003B\u005Cn        \u005Cn        sendMetric(metric)\u003B\u005Cn\u005Cn        scene2.classList.add(\u0027hidden\u0027)\u003B\u005Cn        sceneOk.classList.remove(\u0027hidden\u0027)\u003B\u005Cn      }\u005Cn\u005Cn      // both SMS and email subscriptions respond with the same JSON format\u005Cn      function performFetch(fetchRequest) {\u005Cn        fetch(fetchRequest).then(response \u003D\u003E {\u005Cn          return response.json()\u003B\u005Cn        }).then(json \u003D\u003E {\u005Cn          if (json.status \u003D\u003D\u003D \u0027ok\u0027) {\u005Cn            subscribeOk()\u003B\u005Cn          } else {\u005Cn            subscribeError()\u003B\u005Cn          }\u005Cn        }).catch(err \u003D\u003E {\u005Cn          subscribeError()\u003B\u005Cn        })\u003B\u005Cn      }\u005Cn\u005Cn      function sendSMSToBasket() {\u005Cn        const formData \u003D new FormData()\u003B\u005Cn\u005Cn        sendMetric(\u0027conversion\u002Dmobile\u002Dactivation\u002Dsms\u0027)\u003B\u005Cn\u005Cn        formData.append(\u0027mobile_number\u0027, input.value)\u003B\u005Cn        formData.append(\u0027msg_name\u0027, \u0027focus_sms_android\u0027)\u003B\u005Cn        formData.append(\u0027lang\u0027, locale)\u003B\u005Cn        formData.append(\u0027country\u0027, country)\u003B\u005Cn        \u005Cn        const fetchConfig \u003D {\u005Cn          body: formData,\u005Cn          method: \u0027post\u0027\u005Cn        }\u003B\u005Cn\u005Cn        const fetchRequest \u003D new Request(\u0027https://basket.mozilla.org/news/subscribe_sms/\u0027, fetchConfig)\u003B\u005Cn\u005Cn        performFetch(fetchRequest)\u003B\u005Cn      }\u005Cn\u005Cn      function sendEmailToBasket() {\u005Cn        const formData \u003D new FormData()\u003B\u005Cn\u005Cn        sendMetric(\u0027conversion\u002Dmobile\u002Dactivation\u002Demail\u0027)\u003B\u005Cn\u005Cn        formData.append(\u0027email\u0027, input.value)\u003B\u005Cn        formData.append(\u0027lang\u0027, locale)\u003B\u005Cn        formData.append(\u0027newsletters\u0027, \u0027download\u002Dfocus\u002Dmobile\u0027)\u003B\u005Cn        formData.append(\u0027source_url\u0027, encodeURIComponent(\u0027https://snippets.mozilla.com/show/7990\u0027))\u003B\u005Cn        \u005Cn        const fetchConfig \u003D {\u005Cn          body: formData,\u005Cn          method: \u0027post\u0027\u005Cn        }\u003B\u005Cn\u005Cn        const fetchRequest \u003D new Request(\u0027https://basket.mozilla.org/news/subscribe/\u0027, fetchConfig)\u003B\u005Cn\u005Cn        performFetch(fetchRequest)\u003B\u005Cn      }\u005Cn\u005Cn      // displays scene 2/the form\u005Cn      learnMoreButton.addEventListener(\u0027click\u0027, () \u003D\u003E {\u005Cn        sendMetric(\u0027button\u002Dclick\u0027)\u003B\u005Cn\u005Cn        scene1.classList.add(\u0027hidden\u0027)\u003B\u005Cn        scene2.classList.remove(\u0027hidden\u0027)\u003B\u005Cn\u005Cn        sendToDeviceForm.addEventListener(\u0027submit\u0027, e \u003D\u003E {\u005Cn          e.preventDefault()\u003B\u005Cn\u005Cn          // disable form submit button\u005Cn          scene2Submit.disabled \u003D true\u003B\u005Cn\u005Cn          if (input_type \u003D\u003D\u