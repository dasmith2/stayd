u005C.,\u003B:\u005C\u005Cs@\u005C\u0022]+)*)|(\u005C\u0022.+\u005C\u0022))@((\u005C\u005C[[0\u002D9]{1,3}\u005C\u005C.[0\u002D9]{1,3}\u005C\u005C.[0\u002D9]{1,3}\u005C\u005C.[0\u002D9]{1,3}])|(([a\u002DzA\u002DZ\u005C\u005C\u002D0\u002D9]+\u005C\u005C.)+[a\u002DzA\u002DZ]{2,}))$/\u003B\u005Cn        const check_email \u003D email_re.test(val)\u003B\u005Cn        let check_phone\u003B // depends on locale\u005Cn\u005Cn        switch (locale) {\u005Cn          case \u0027en\u002DUS\u0027:\u005Cn            // allow 10\u002D11 digits in case user wants to enter country code\u005Cn            check_phone \u003D val.length \u003E\u003D 10 \u0026\u0026 val.length \u003C\u003D 11 \u0026\u0026 !isNaN(val)\u003B\u005Cn            break\u003B\u005Cn          case \u0027de\u0027:\u005Cn            // allow between 2 and 12 digits for german phone numbers\u005Cn            check_phone \u003D val.length \u003E\u003D 2 \u0026\u0026 val.length \u003C\u003D 12 \u0026\u0026 !isNaN(val)\u003B\u005Cn            break\u003B\u005Cn          // this case should never be hit, but good to have a fallback just in case\u005Cn          default:\u005Cn            check_phone \u003D !isNaN(val)\u003B\u005Cn            break\u003B\u005Cn        }\u005Cn        \u005Cn        if (check_email) {\u005Cn            return \u0027email\u0027\u003B\u005Cn        } else if (\u0027True\u0027 \u003D\u003D\u003D \u0027True\u0027 \u0026\u0026 check_phone) {\u005Cn            return \u0027phone\u0027\u003B\u005Cn        } else {\u005Cn            return false\u003B\u005Cn        }\u005Cn      }\u005Cn\u005Cn      // if fetch request fails, show the error message\u005Cn      function subscribeError() {\u005Cn        const metric \u003D input_type \u003D\u003D\u003D \u0027email\u0027 ? \u0027activation\u002Demail\u002Derror\u0027 : \u0027activation\u002DSMS\u002Derror\u0027\u003B\u005Cn        \u005Cn        sendMetric(metric)\u003B\u005Cn        \u005Cn        scene2.classList.add(\u0027hidden\u0027)\u003B\u005Cn        sceneError.classList.remove(\u0027hidden\u0027)\u003B\u005Cn      }\u005Cn  \u005Cn      // if fetch request is successful, show the success message\u005Cn      function subscribeOk() {\u005Cn        const metric \u003D (input_type \u003D\u003D\u003D \u0027email\u0027) ? \u0027activation\u002Demail\u002Dsuccess\u0027 : \u0027activation\u002DSMS\u002Dsuccess\u0027\u003B\u005Cn        \u005Cn        sendMetric(metric)\u003B\u005Cn\u005Cn        scene2.classList.add(\u0027hidden\u0027)\u003B\u005Cn        sceneOk.classList.remove(\u0027hidden\u0027)\u003B\u005Cn      }\u005Cn\u005Cn      // both SMS and email subscriptions respond with the same JSON format\u005Cn      function performFetch(fetchRequest) {\u005Cn        fetch(fetchRequest).then(response \u003D\u003E {\u005Cn          return response.json()\u003B\u005Cn        }).then(json \u003D\u003E {\u005Cn          if (json.status \u003D\u003D\u003D \u0027ok\u0027) {\u005Cn            subscribeOk()\u003B\u005Cn          } else {\u005Cn            subscribeError()\u003B\u005Cn          }\u005Cn        }).catch(err \u003D\u003E {\u005Cn          subscribeError()\u003B\u005Cn        })\u003B\u005Cn      }\u005Cn\u005Cn      function sendSMSToBasket() {\u005Cn        const formData \u003D new FormData()\u003B\u005Cn\u005Cn        sendMetric(\u0027conversion\u002Dmobile\u002Dactivation\u002Dsms\u0027)\u003B\u005Cn\u005Cn        formData.append(\u0027mobile_number\u0027, input.value)\u003B\u005Cn        formData.append(\u0027msg_name\u0027, \u0027ff\u002Dmobilesn\u002Ddownload\u0027)\u003B\u005Cn        formData.append(\u0027lang\u0027, locale)\u003B\u005Cn        formData.append(\u0027country\u0027, country)\u003B\u005Cn        \u005Cn        const fetchConfig \u003D {\u005Cn          body: formData,\u005Cn          method: \u0027post\u0027\u005Cn        }\u003B\u005Cn\u005Cn        const fetchRequest \u003D new Request(\u0027https://basket.mozilla.org/news/subscribe_sms/\u0027, fetchConfig)\u003B\u005Cn\u005Cn        performFetch(fetchRequest)\u003B\u005Cn      }\u005Cn\u005Cn      function sendEmailToBasket() {\u005Cn        const formData \u003D new FormData()\u003B\u005Cn\u005Cn        sendMetric(\u0027conversion\u002Dmobile\u002Dactivation\u002Demail\u0027)\u003B\u005Cn\u005Cn        formData.append(\u0027email\u0027, input.value)\u003B\u005Cn        formData.append(\u0027lang\u0027, locale)\u003B\u005Cn        formData.append(\u0027newsletters\u0027, \u0027download\u002Dfirefox\u002Dmobile\u0027)\u003B\u005Cn        formData.append(\u0027source_url\u0027, encodeURIComponent(\u0027https://snippets.mozilla.com/show/7962\u0027))\u003B\u005Cn        \u005Cn        const fetchConfig \u003D {\u005Cn          body: formData,\u005Cn          method: \u0027post\u0027\u005Cn        }\u003B\u005Cn\u005Cn        const fetchRequest \u003D new Request(\u0027https://basket.mozilla.org/news/subscribe/\u0027, fetchConfig)\u003B\u005Cn\u005Cn        performFetch(fetchRequest)\u003B\u005Cn      }\u005Cn\u005Cn      // displays scene 2/the form\u005Cn      learnMoreButton.addEventListener(\u0027click\u0027, () \u003D\u003E {\u005Cn        sendMetric(\u0027button\u002Dclick\u0027)\u003B\u005Cn\u005Cn        scene1.classList.add(\u0027hidden\u0027)\u003B\u005Cn        scene2.classList.remove(\u0027hidden\u0027)\u003B\u005Cn\u005Cn        sendToDeviceForm.addEventListener(\u0027submit\u0027, e \u003D\u003E {\u005Cn          e.preventDefault()\u003B\u005Cn\u005Cn          // disable form submit button\u005Cn          scene2Submit.disabled \u003D true\u003B\u005Cn\u005Cn          if (input_type \u003D\u003D\u003D \u0027email\u0027) {\u005Cn            sendEmailToBasket()\u003B\u005Cn          } else if (input_type \u003D\u003D\u003D \u0027phone\u0027) {\u005Cn            sendSMSToBasket()\u003B\u005Cn          }\u005Cn        })\u003B\u005Cn      })\u003B\u005Cn\u005Cn      // check input while typing\u005Cn      input.addEventListener(\u0027input\u0027, () \u003D\u003E {\u005Cn        input_type \u003D checkInput(input.value, locale)\u003B\u005Cn\u005Cn        // disable the submit button while input_type is false\u005Cn        scene2Submit.disabled \u003D (input_type \u003D\u003D\u003D false)\u003B\u005Cn      })\u003B\u005Cn\u005Cn      // initializes input_type by firing the input handler above on page load\u005Cn      const evt \u003D document.createEvent(\u0027HTMLEvents\u0027)\u003B\u005Cn      evt.initEvent(\u0027input\u0027, false, true)\u003B\u005Cn      input.dispatchEvent(evt)\u003B\u005Cn    })\u003B\u005Cn  })()\u003B\u005Cn  //]]\u003E\u005Cn\u003C/script\u003E\u003C/div\u003E\u0022, \u0022exclude_from_search_engines\u0022: [], \u0022name\u0022: \u0022MOCO_US_2018_f100_week14_mobile_fullfeatured_activity_stream_EN_REL\u0022, \u0022campaign\u0022: \u0022f100 mobile\u0022, \u0022countries\u0022: [\u0022us\u0022], \u0022client_options\u0022: {\u0022has_testpilot\u0022: \u0022any\u0022, \u0022is_default_browser\u0022: \u0022any\u0022, \u0022screen_resolutions\u0022: \u00220\u002D1024\u003B1024\u002D1920\u003B1920\u002D50000\u0022, \u0022version_lower_bound\u0022: \u0022any\u0022, \u0022profileage_upper_bound\u0022: 15, \u0022has_fxaccount\u0022: \u0022any\u0022, \u0022profileage_lower_bound\u0022: 13, \u0022version_upper_bound\u0022: \u0022any\u0022}, \u0022id\u0022: 7962, \u0022weight\u0022: 33}, {\u0022code\u0022: \u0022\u003Cdiv data\u002Dsnippet\u002Did\u003D\u005C\u00227858\u005C\u0022 data\u002Dweight\u003D\u005C\u002250\u005C\u0022 data\u002Dcampaign\u003D\u005C\u0022f100 addons power up\u005C\u0022 class\u003D\u005C\u0022snippet\u002Dmetadata\u005C\u0022\u003E\u005Cn\u003Cstyle\u003E\u005Cn  #snippet {\u005Cn    display: flex\u003B\u005Cn    justify\u002Dcontent: center\u003B\u005Cn    align\u002Ditems: center\u003B\u005Cn    \u005Cn  }\u005Cn\u005Cn  .snippet section {\u005Cn    color: #000000\u003B\u005Cn    font\u002Dsize: 12px\u003B\u005Cn  }\u005Cn\u005Cn  .snippet h1 {\u005Cn    margin: 0\u003B\u005Cn    font\u002Dweight: b